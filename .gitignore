# The real config is never committed — only the sanitized template is tracked.
EFI/OC/config.plist

# Fetched third-party binaries are NOT committed (see components.lock.json / fetch script).
EFI/OC/OpenCore.efi
EFI/BOOT/BOOTx64.efi
EFI/OC/Drivers/*.efi
EFI/OC/Tools/*.efi
EFI/OC/Kexts/*.kext/

# transient / OS cruft
downloads/
*.zip
.DS_Store
._*
